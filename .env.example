# Copy to .env and fill in. Never commit a real .env file.
# Local dev uses the values from README.md ("Getting started").

# PostgreSQL — local dev (docker-compose.yml) or your own instance.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/invoicing"
# Used by the test suite only.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/invoicing_test"

# Auth.js — generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# First-deploy admin bootstrap (optional): `npm run db:seed` creates
# this owner account when BOTH are set. Never commit real values.
# ADMIN_EMAIL="admin@yourcompany.ae"
# ADMIN_PASSWORD="use-a-long-random-password"
# ADMIN_NAME="Admin"
# ADMIN_BUSINESS_NAME="Your Business LLC"

# Staging demo data only: DEMO_SEED=1 creates demo@invoicing.local.
# Never set this in production.
# DEMO_SEED="0"

# Trust the request host (needed behind proxies / when the dev port
# differs from NEXTAUTH_URL). Required for Auth.js in production —
# without it, every sign-in fails with UntrustedHost.
AUTH_TRUST_HOST="true"

# Email provider: log (dev, prints to console) | resend | smtp
EMAIL_PROVIDER="log"
# RESEND_API_KEY=""
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""

# Storage provider: local (dev) | s3
STORAGE_PROVIDER="local"
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Prisma engines workaround (this VM only): the egress proxy resets
# Node's downloads from binaries.prisma.sh. Engines are fetched with
# curl instead — see scripts/setup-prisma-engines.sh. Only needed if
# `prisma --version` fails with ECONNRESET.
# PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
